{
  "expo": {
    "name": "Paws",
    "slug": "paws",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "dev.paws.companion",
      "allowBackup": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Paws to scan the pairing QR on your computer.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withSigning.cjs",
      "./plugins/withBranding.cjs",
      "./plugins/withPairing.cjs"
    ],
    "scheme": "paws"
  }
}
