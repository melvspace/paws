{
  "name": "paws",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @paws/server --filter @paws/web dev",
    "dev:desktop": "pnpm --filter @paws/desktop dev",
    "build": "pnpm --filter @paws/web build",
    "serve:web": "pnpm --filter @paws/web serve",
    "typecheck": "pnpm -r typecheck",
    "test": "vp test run && pnpm --filter @paws/web test:browser",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "runtime:build": "docker build -f packages/runtime/docker/Dockerfile.team -t paws-team-runtime:1 packages/runtime/docker",
    "build:desktop": "pnpm build && pnpm --filter @paws/desktop package",
    "build:server": "node scripts/build-server.mjs",
    "build:image": "docker build -t paws:local .",
    "dev:mobile": "pnpm --filter @paws/mobile dev",
    "build:android": "pnpm --filter @paws/mobile prebuild && cd apps/mobile/android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
